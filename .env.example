# =============================================================================
# .env.example — Manicure Fácil (Nail Boss Suite)
# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# SECURITY: Nunca commite o .env no git. Ele já está no .gitignore.
# =============================================================================

# ─────────── Supabase (OBRIGATÓRIO) ─────────────────────────────────────────
# Crie um projeto gratuito em https://supabase.com
# As credenciais estão em: Project Settings > API

# URL do projeto (ex: https://xxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anon/pública — SEGURA para expor ao cliente (VITE_ prefix)
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica

# Chave service_role — NUNCA expor ao cliente (usada apenas server-side)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# ─────────── Lovable Cloud Auth (OPCIONAL) ──────────────────────────────────
# Configure no painel Lovable Cloud se usar login social
# LOVABLE_CLOUD_AUTH_KEY=your_lovable_auth_key_here

# ─────────── AI Provider ────────────────────────────────────────────────────
# Escolha entre "openai" (padrão) ou "gemini"
AI_PROVIDER=openai

# ─────────── OpenAI (OBRIGATÓRIO se AI_PROVIDER=openai ou para fallback) ───
# Crie em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua-chave-aqui

# Modelo (opcional — padrão: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Temperatura (opcional — padrão: 0.7)
# OPENAI_TEMPERATURE=0.7

# Máximo de tokens (opcional — padrão: 2048)
# OPENAI_MAX_TOKENS=2048

# ─────────── Google Gemini (OBRIGATÓRIO se AI_PROVIDER=gemini ou fallback) ─
# Crie em: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-sua-chave-aqui

# Modelo (opcional — padrão: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Temperatura (opcional — padrão: 0.7)
# GEMINI_TEMPERATURE=0.7

# Máximo de tokens de saída (opcional — padrão: 2048)
# GEMINI_MAX_OUTPUT_TOKENS=2048

# ─────────── Node.js ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─────────── Backup (OPCIONAL) ──────────────────────────────────────────────
# Configuração para backup automático em cloud storage (S3-compatible)
# BACKUP_S3_BUCKET=my-backup-bucket
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=your-access-key
# BACKUP_S3_SECRET_KEY=your-secret-key
