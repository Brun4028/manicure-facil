# =============================================================================
# .env.example — Manicure Fácil (Nail Boss Suite)
# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
#
# SECURITY: Nunca commite o .env no git. Ele já está no .gitignore.
# =============================================================================

# ─────────── Supabase (OBRIGATÓRIO) ─────────────────────────────────────────
# Crie um projeto gratuito em https://supabase.com
# As credenciais estão em: Project Settings > API

# URL do projeto (ex: https://xxxxxxx.supabase.co)
# - VITE_SUPABASE_URL: usada no client (navegador)
# - SUPABASE_URL: usada server-side (auth middleware, server functions, Docker)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anon/pública — SEGURA para expor ao cliente (VITE_ prefix)
# - VITE_SUPABASE_PUBLISHABLE_KEY: embutida no bundle do cliente (navegador)
# - SUPABASE_PUBLISHABLE_KEY: usada server-side (auth middleware p/ setar sessão)
# As DUAS devem ser a MESMA chave anon do projeto (Project Settings > API).
VITE_SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica
SUPABASE_PUBLISHABLE_KEY=sua-chave-anon-publica

# Chave service_role — NUNCA expor ao cliente (usada apenas server-side)
# ⚠️ OBRIGATÓRIA em produção: sem ela, o AGENDAMENTO PÚBLICO (/agendar/:id)
# e o PAINEL ADMIN quebram (as server functions usam o client service_role).
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# ID do projeto Supabase (ex: aaaaabbbbbccccddd) — usado pelo CLI/tooling
# SUPABASE_PROJECT_ID=seu-project-ref
# VITE_SUPABASE_PROJECT_ID=seu-project-ref

# ─────────── Lovable Cloud Auth (OPCIONAL) ──────────────────────────────────
# Configure no painel Lovable Cloud se usar login social
# LOVABLE_CLOUD_AUTH_KEY=your_lovable_auth_key_here

# ─────────── Admin do SaaS (OBRIGATÓRIO para o painel Admin) ────────────────
# E-mails com acesso ao painel administrativo (separados por vírgula).
# Alternativa: marcar is_admin=true na tabela public.contas (recomendado):
#   SELECT public.definir_admin('seu@email.com');
ADMIN_EMAILS=voce@seu-email.com

# ─────────── AI Provider ────────────────────────────────────────────────────
# Escolha entre "gemini" (recomendado — tem nível gratuito) ou "openai"
AI_PROVIDER=gemini

# ⚠️ DEPLOY NA VERCEL: além do .env local, configure as variáveis de IA no
# painel da Vercel (Project → Settings → Environment Variables) para os
# ambientes Production/Preview/Development. Sem elas, o servidor da Vercel
# não enxerga a chave e o assistente responde "chave de IA não configurada":
#   AI_PROVIDER  →  gemini
#   GEMINI_API_KEY  →  sua chave (começa com AIza... ou AQ....)
#   OPENAI_API_KEY  →  (opcional, se usar OpenAI ou quiser fallback)
# Depois de adicionar, faça um NOVO deploy. O app tem um diagnóstico em
# Configurações do Assistente que mostra se a chave chegou ao servidor.
# Nota: chaves novas do AI Studio podem começar com "AQ." — formato válido.

# ─────────── OpenAI (OBRIGATÓRIO se AI_PROVIDER=openai ou para fallback) ───
# Crie em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-sua-chave-aqui

# Modelo (opcional — padrão: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Temperatura (opcional — padrão: 0.7)
# OPENAI_TEMPERATURE=0.7

# Máximo de tokens (opcional — padrão: 2048)
# OPENAI_MAX_TOKENS=2048

# ─────────── Google Gemini (OBRIGATÓRIO se AI_PROVIDER=gemini ou fallback) ─
# Crie em: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza-sua-chave-aqui

# Modelo (opcional — padrão: gemini-flash-latest, com cota gratuita)
# GEMINI_MODEL=gemini-flash-latest

# Temperatura (opcional — padrão: 0.7)
# GEMINI_TEMPERATURE=0.7

# Máximo de tokens de saída (opcional — padrão: 2048)
# GEMINI_MAX_OUTPUT_TOKENS=2048

# ─────────── Node.js ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ─────────── Backup (OPCIONAL) ──────────────────────────────────────────────
# Configuração para backup automático em cloud storage (S3-compatible)
# BACKUP_S3_BUCKET=my-backup-bucket
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_ACCESS_KEY=your-access-key
# BACKUP_S3_SECRET_KEY=your-secret-key
